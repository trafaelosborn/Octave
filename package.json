{
  "name": "@trafaelosborn/octave",
  "version": "0.1.0",
  "description": "A local-first research workstation with document-aware chat and LaTeX compilation.",
  "license": "MIT",
  "author": "Taylor Osborn",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "import": "./dist/providers/index.js"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "import": "./dist/storage/index.js"
    }
  },
  "bin": {
    "octave": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "npm run build:lib && npm run dev:web",
    "dev:web": "next dev --hostname 127.0.0.1",
    "desktop:dev": "npm run build:lib && node desktop/dev.cjs",
    "desktop:prepare": "npm run build && node desktop/prepare-runtime.cjs",
    "desktop:smoke": "node desktop/smoke-runtime.cjs",
    "desktop:package": "npm run desktop:prepare && node desktop/forge.cjs package",
    "desktop:make": "npm run desktop:prepare && node desktop/forge.cjs make",
    "build": "npm run build:lib && next build",
    "build:lib": "tsc -p tsconfig.build.json",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "npm run build:lib && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:core": "npm run typecheck && npm test",
    "check": "npm run check:core && npm run build",
    "demo": "tsx examples/library-usage.ts",
    "prepack": "npm run build:lib"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "research",
    "latex",
    "local-first",
    "llm",
    "ollama",
    "anthropic"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trafaelosborn/Octave.git"
  },
  "bugs": {
    "url": "https://github.com/trafaelosborn/Octave/issues"
  },
  "homepage": "https://github.com/trafaelosborn/Octave#readme",
  "dependencies": {
    "katex": "^0.18.0",
    "next": "^16.2.10",
    "officeparser": "^7.3.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "overrides": {
    "postcss": "^8.5.19"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "^43.1.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
