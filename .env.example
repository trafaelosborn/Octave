# Only required when using the Anthropic provider.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI API provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_BASE_URL=https://api.openai.com

# xAI / Grok provider.
XAI_API_KEY=
XAI_MODEL=grok-4.5-latest
XAI_BASE_URL=https://api.x.ai

# Optional Ollama overrides.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1

# Optional application defaults.
OCTAVE_ROOT=
OCTAVE_CONFIG_DIR=
OCTAVE_DEFAULT_PROVIDER=ollama
